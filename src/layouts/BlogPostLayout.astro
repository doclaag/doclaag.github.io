---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getLangFromUrl, localizePath, otherLang, useTranslations } from '../i18n/utils';
import { postSlug } from '../lib/blog';
import { blogPostingJsonLd } from '../lib/jsonld';

interface Props {
  post: CollectionEntry<'blog'>;
  minutesRead: number;
}

const { post, minutesRead } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const other = otherLang(lang);

const counterpart = (
  await getCollection(
    'blog',
    ({ data }) => data.lang === other && data.translationKey === post.data.translationKey,
  )
).at(0);
const altPath = counterpart
  ? localizePath(`/blog/${postSlug(counterpart.id)}/`, other)
  : localizePath('/blog/', other);

const jsonLd = blogPostingJsonLd({
  title: post.data.title,
  description: post.data.description,
  pubDate: post.data.pubDate,
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  lang,
});
---

<BaseLayout
  title={`${post.data.title} — Luis Alonzo`}
  description={post.data.description}
  altPath={altPath}
  type="article"
  jsonLd={jsonLd}
>
  <article class="mx-auto max-w-3xl px-5 py-16 sm:px-8">
    <header class="mb-10">
      <p class="mb-6">
        <a
          href={localizePath('/blog/', lang)}
          class="font-mono text-sm text-accent underline-offset-4 hover:underline"
        >
          ← {t('blog.backToBlog')}
        </a>
      </p>
      <h1 class="font-display text-3xl font-bold tracking-tight text-balance text-ink sm:text-4xl">
        {post.data.title}
      </h1>
      <p class="mt-4 flex items-center gap-3 font-mono text-xs text-faint">
        <FormattedDate date={post.data.pubDate} />
        <span aria-hidden="true">·</span>
        <span>{minutesRead} {t('blog.minutesRead')}</span>
      </p>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
