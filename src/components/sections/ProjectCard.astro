---
import type { EnrichedProject } from '../../lib/github';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

interface Props {
  project: EnrichedProject;
}

const { project } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const updated = project.pushedAt
  ? new Date(project.pushedAt).toLocaleDateString(lang === 'en' ? 'en-US' : 'es-GT', {
      year: 'numeric',
      month: 'short',
      timeZone: 'UTC',
    })
  : null;

/** "the-valley-medical-clinic-frontend" -> "frontend" for compact link labels. */
function shortLabel(repoName: string): string {
  const match = repoName.match(/-(frontend|backend|deploy|api|web)$/);
  return match ? match[1]! : repoName;
}
---

<article
  class="group flex h-full flex-col rounded-lg border border-line bg-surface p-6 transition-colors hover:border-accent/50"
>
  <header class="flex items-start justify-between gap-3">
    <h3 class="font-display text-lg font-semibold text-ink">
      {project.title}
    </h3>
    <svg
      class="mt-1 size-5 shrink-0 text-faint transition-colors group-hover:text-accent"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      aria-hidden="true"
    >
      <path d="M5 12V6a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1h-6"></path>
      <path d="m5 19 9-9m0 0H7.5M14 10v6.5" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </header>
  <p class="mt-3 grow text-sm leading-relaxed text-muted">
    {project.description[lang]}
  </p>
  <div class="mt-5 flex flex-wrap gap-2">
    {
      project.links.map((link) => (
        <a
          href={link.url}
          class="rounded border border-line px-2 py-0.5 font-mono text-xs text-muted transition-colors hover:border-accent hover:text-accent"
        >
          {shortLabel(link.name)} ↗
        </a>
      ))
    }
  </div>
  <footer class="mt-4 flex items-center gap-3 border-t border-line pt-4 font-mono text-xs text-faint">
    {
      project.language && (
        <span class="flex items-center gap-1.5">
          <span class="size-2 rounded-full bg-accent" aria-hidden="true" />
          {project.language}
        </span>
      )
    }
    <span class="text-faint/70">{project.tech.join(' · ')}</span>
    {updated && <span class="ml-auto">{t('projects.updated')} {updated}</span>}
  </footer>
</article>
