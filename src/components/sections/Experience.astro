---
import { getCollection } from 'astro:content';
import Reveal from '../Reveal.astro';
import SectionHeading from '../SectionHeading.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const entries = await getCollection('experience');
const hasPlaceholders = entries.some((entry) => entry.data.placeholder);
---

<section class="mx-auto max-w-5xl px-5 py-16 sm:px-8">
  <Reveal>
    <SectionHeading index="04" title={t('experience.title')} />
    {
      hasPlaceholders && (
        <p
          class="-mt-4 mb-10 inline-flex items-center gap-2 rounded-md border border-dashed border-line bg-surface px-3 py-1.5 font-mono text-xs text-faint"
          title={t('experience.placeholderNote')}
        >
          <span class="size-1.5 rounded-full bg-accent" aria-hidden="true" />
          {t('experience.placeholder')}
        </p>
      )
    }
    <ol class="space-y-10 border-s border-line ps-6">
      {
        entries.map((entry) => (
          <li class="relative">
            <span
              class="absolute -start-[1.85rem] top-1.5 size-2.5 rounded-full border-2 border-bg bg-accent"
              aria-hidden="true"
            />
            <p class="font-mono text-xs text-faint">
              {entry.data.start} — {entry.data.end ?? t('experience.present')}
            </p>
            <h3 class="mt-1 font-display text-lg font-semibold text-ink">
              {entry.data.role[lang]}
              <span class="font-normal text-muted">· {entry.data.company}</span>
            </h3>
            <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted">
              {entry.data.summary[lang]}
            </p>
            <p class="mt-3 font-mono text-xs text-faint">{entry.data.tech.join(' · ')}</p>
          </li>
        ))
      }
    </ol>
  </Reveal>
</section>
