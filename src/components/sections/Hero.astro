---
import { getLangFromUrl, localizePath, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const home = localizePath('/', lang);
---

<section class="relative overflow-hidden">
  <div
    class="pointer-events-none absolute -top-40 left-1/2 h-130 w-130 -translate-x-1/2 rounded-full"
    style="background: radial-gradient(closest-side, var(--c-glow), transparent)"
    aria-hidden="true"
  >
  </div>
  <div class="mx-auto max-w-5xl px-5 pt-24 pb-20 sm:px-8 sm:pt-36 sm:pb-28">
    <p class="mb-6 font-mono text-sm text-accent">
      <span class="text-faint">~/luis-alonzo $</span>
      {t('hero.greeting')}
    </p>
    <h1
      class="font-display text-4xl font-bold tracking-tight text-balance text-ink sm:text-6xl md:text-7xl"
    >
      Luis Alonzo
    </h1>
    <p class="mt-4 font-display text-xl font-medium text-muted sm:text-2xl">
      {t('hero.role')} <span class="text-faint">·</span>
      <span class="text-accent">{t('hero.location')}</span> 🇬🇹
    </p>
    <p class="mt-6 max-w-xl text-lg leading-relaxed text-pretty text-muted">
      {t('hero.tagline')}
    </p>
    <div class="mt-10 flex flex-wrap items-center gap-4">
      <a
        href={`${home}#projects`}
        class="rounded-md bg-accent px-5 py-2.5 font-mono text-sm font-medium text-bg transition-colors hover:bg-accent-strong"
      >
        {t('hero.ctaProjects')}
      </a>
      <a
        href={`${home}#contact`}
        class="rounded-md border border-line px-5 py-2.5 font-mono text-sm text-ink transition-colors hover:border-accent hover:text-accent"
      >
        {t('hero.ctaContact')}
      </a>
    </div>
  </div>
</section>
