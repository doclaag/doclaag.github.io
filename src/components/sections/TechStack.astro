---
import Reveal from '../Reveal.astro';
import SectionHeading from '../SectionHeading.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const groups = [
  { label: t('stack.frontend'), items: ['TypeScript', 'React', 'Next.js', 'Astro', 'Tailwind CSS'] },
  { label: t('stack.backend'), items: ['Node.js', 'PHP', 'Laravel', 'Python'] },
  { label: t('stack.databases'), items: ['PostgreSQL', 'MySQL'] },
  { label: t('stack.tools'), items: ['Git', 'Linux', 'Postman', 'Jest'] },
];
---

<section class="mx-auto max-w-5xl px-5 py-16 sm:px-8">
  <Reveal>
    <SectionHeading index="02" title={t('stack.title')} />
    <dl class="grid gap-x-10 gap-y-8 sm:grid-cols-2">
      {
        groups.map((group) => (
          <div class="border-t border-line pt-4">
            <dt class="font-mono text-xs tracking-widest text-faint uppercase">{group.label}</dt>
            <dd class="mt-3 flex flex-wrap gap-2">
              {group.items.map((item) => (
                <span class="rounded-md border border-line bg-surface px-2.5 py-1 font-mono text-xs text-muted">
                  {item}
                </span>
              ))}
            </dd>
          </div>
        ))
      }
    </dl>
  </Reveal>
</section>
