---
import { getLangFromUrl } from '../i18n/utils';

interface Props {
  date: Date;
}

const { date } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const formatted = date.toLocaleDateString(lang === 'en' ? 'en-US' : 'es-GT', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<time datetime={date.toISOString().slice(0, 10)} class="font-mono text-xs text-faint">
  {formatted}
</time>
