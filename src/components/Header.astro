---
import ThemeToggle from './ThemeToggle.astro';
import LanguageToggle from './LanguageToggle.astro';
import { getLangFromUrl, localizePath, useTranslations } from '../i18n/utils';

interface Props {
  altPath?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const home = localizePath('/', lang);

const links = [
  { href: `${home}#about`, label: t('nav.about') },
  { href: `${home}#projects`, label: t('nav.projects') },
  { href: localizePath('/blog/', lang), label: t('nav.blog') },
  { href: `${home}#contact`, label: t('nav.contact') },
];
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-4 px-5 sm:px-8">
    <a href={home} class="font-mono text-sm text-ink transition-colors hover:text-accent">
      <span class="text-accent">~</span>/luis-alonzo
      <span class="text-faint">$</span>
    </a>
    <div class="flex items-center gap-1 sm:gap-2">
      <nav aria-label="Main" class="mr-2 hidden items-center gap-5 sm:flex">
        {
          links.map((link) => (
            <a href={link.href} class="text-sm text-muted transition-colors hover:text-ink">
              {link.label}
            </a>
          ))
        }
      </nav>
      <LanguageToggle altPath={Astro.props.altPath} />
      <ThemeToggle />
    </div>
  </div>
</header>
