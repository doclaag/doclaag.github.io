---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { useTranslations } from '../../i18n/utils';
import { postSlug } from '../../lib/blog';

const t = useTranslations('en');
const posts = (await getCollection('blog', ({ data }) => data.lang === 'en' && !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title={`${t('blog.title')} — Luis Alonzo`} description={t('blog.description')} altPath="/es/blog/">
  <div class="mx-auto max-w-3xl px-5 py-16 sm:px-8">
    <h1 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">
      {t('blog.title')}
    </h1>
    <p class="mt-3 text-muted">{t('blog.description')}</p>
    <ul class="mt-12 space-y-10">
      {
        posts.map((post) => (
          <li>
            <article>
              <FormattedDate date={post.data.pubDate} />
              <h2 class="mt-1 font-display text-xl font-semibold">
                <a
                  href={`/blog/${postSlug(post.id)}/`}
                  class="text-ink transition-colors hover:text-accent"
                >
                  {post.data.title}
                </a>
              </h2>
              <p class="mt-2 text-sm leading-relaxed text-muted">{post.data.description}</p>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
